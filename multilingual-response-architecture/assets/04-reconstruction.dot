digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=TB; label="Flat-to-tree reconstruction in two passes"; 
flat [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="1" CELLSPACING="0" CELLPADDING="6" COLOR="#456a8e"><TR><TD BGCOLOR="#dbe8f5"><B>ID</B></TD><TD BGCOLOR="#dbe8f5"><B>Parent</B></TD><TD BGCOLOR="#dbe8f5"><B>Node</B></TD></TR><TR><TD>5</TD><TD>4</TD><TD>items</TD></TR><TR><TD>2</TD><TD>1</TD><TD>title</TD></TR><TR><TD>1</TD><TD>NULL</TD><TD>header</TD></TR><TR><TD>4</TD><TD>NULL</TD><TD>amount</TD></TR></TABLE>>]; index [label="Pass 1: index by ID\n5 → items\n2 → title\n1 → header\n4 → amount",fillcolor="#fff1d5",color="#b88b3c"]; attach [label="Pass 2: attach to parent\nExpected O(1) lookup per node",fillcolor="#fff1d5",color="#b88b3c"]; root [label="Root collection",fillcolor="#d9eee5",color="#328262"]; h [label="header (1)"]; a [label="amount (4)"]; t [label="title (2)"]; i [label="items (5)"]; flat->index->attach->root; root->{h a}; h->t; a->i; }