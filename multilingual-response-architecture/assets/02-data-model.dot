digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=LR; label="Relational adjacency list and logical hierarchy"; 
table [shape=plain,label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="7" COLOR="#456a8e"><TR><TD BGCOLOR="#dbe8f5" COLSPAN="2"><B>t_mobile_ui_nodes</B></TD></TR><TR><TD ALIGN="LEFT">id (PK)</TD><TD>BIGINT</TD></TR><TR><TD ALIGN="LEFT">parent_id (FK → id)</TD><TD>BIGINT</TD></TR><TR><TD ALIGN="LEFT">screen_code</TD><TD>VARCHAR</TD></TR><TR><TD ALIGN="LEFT">node_key / node_type</TD><TD>VARCHAR</TD></TR><TR><TD ALIGN="LEFT">sort_order</TD><TD>INTEGER</TD></TR><TR><TD ALIGN="LEFT">translations_id / en / zh</TD><TD>JSONB</TD></TR><TR><TD ALIGN="LEFT">value_key</TD><TD>TEXT</TD></TR><TR><TD ALIGN="LEFT">created_at / updated_at</TD><TD>TIMESTAMPTZ</TD></TR></TABLE>>]; parent [label="Parent row\nid = 4"]; child [label="Child row\nid = 5; parent_id = 4"]; leaf [label="Leaf row\nid = 6; parent_id = 5"]; table->parent [label="example rows"]; parent->child [label="contains"]; child->leaf [label="contains"]; child->parent [style=dashed,color="#b88b3c",label="FK",constraint=false]; leaf->child [style=dashed,color="#b88b3c",label="FK",constraint=false]; }