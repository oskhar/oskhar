digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=TB; label="Node vocabulary and evaluated types"; 
input [label="Configuration node\nNodeTypeEnum",fillcolor="#d9eee5",color="#328262"]; o [label="OBJECT"]; a [label="ARRAY"]; f [label="FIELD"]; l [label="LABEL"]; v [label="VALUE"]; input->{o a f l v}; om [label="LinkedHashMap\nNamed children"]; al [label="ArrayList\nOrdered children"]; fm [label="MobileField\nMetadata + runtime values"]; ls [label="String or null\nLocalized label"]; vm [label="Object or null\nDirect runtime value"]; o->om;a->al;f->fm;l->ls;v->vm; {rank=same;o;a;f;l;v} }