digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=TB; label="Tree height controls recursion stack"; 
subgraph cluster_w { label="Wide tree: small h"; color="#c7d4e1"; w0 [label="root"]; w1 [label="1"]; w2 [label="2"]; w3 [label="3"]; w4 [label="4"]; w5 [label="5"]; w0->{w1 w2 w3 w4 w5}; wn [shape=note,label="6 nodes; depth = 2\n2 active stack frames",fillcolor="#d9eee5",color="#328262"]; w1->wn [style=invis]; }
subgraph cluster_d {label="Skewed tree: h approaches n";color="#c7d4e1"; d0 [label="root"];d1 [label="1"];d2 [label="2"];d3 [label="3"];d4 [label="4"];d5 [label="5"];d0->d1->d2->d3->d4->d5; dn [shape=note,label="6 nodes; depth = 6\n6 active stack frames",fillcolor="#fff1d5",color="#b88b3c"];d5->dn [style=invis];} {rank=same;w0;d0} }