digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=TB; label="End-to-end cost is more than DFS"; 
a [label="Workflow + validation\nExternal and domain costs"];b [label="Normalize runtime DTO\nO(d)"];c [label="Fetch + order configuration\nDB-dependent; sort may be O(n log n)"];d [label="Reconstruct hierarchy\nExpected O(n)"];e [label="Interpret nodes\nExpected O(n + p + r)"];f [label="DTO conversion + JSON\nOutput-dependent"];g [shape=note,label="n: nodes; d: input size\np: translation metadata; r: output size\nStructural stack: O(h)",fillcolor="#ffffff"]; a->b->c->d->e->f; {rank=same;d;g} }