digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=TB; label="Proposed configuration publication lifecycle"; 
d [label="Draft"];v [label="Validate\nGraph, schema, locale, bindings"];r [label="Review + approval"];p [label="Atomic publish\nVersion N",fillcolor="#d9eee5",color="#328262"];c [label="Invalidate config cache"];s [label="Serve + monitor"];bad [label="Reject / revise",fillcolor="#fff1d5",color="#b88b3c"];roll [label="Rollback\nPrevious validated version",fillcolor="#fff1d5",color="#b88b3c"];d->v->r->p->c->s;v->bad [label="invalid"];bad->d [style=dashed];s->roll [label="regression"];roll->c [style=dashed]; }