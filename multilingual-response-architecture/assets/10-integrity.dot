digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=TB; label="Configuration failure modes to validate"; 
