digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=TB; label="Representative response tree (implicit root)"; 
root [label="Implicit root\nOBJECT",fillcolor="#d9eee5",color="#328262"]; h [label="header\nOBJECT"]; s [label="status\nVALUE",fillcolor="#f5e8f8",color="#8c609e"]; a [label="amount\nOBJECT"]; sec [label="sections\nARRAY",fillcolor="#fff1d5",color="#b88b3c"]; f [label="footer\nOBJECT"]; root->{h s a sec f}; title [label="title\nLABEL",fillcolor="#f5e8f8",color="#8c609e"]; h->title; items [label="items\nARRAY",fillcolor="#fff1d5",color="#b88b3c"]; a->items; af [label="amount\nFIELD",fillcolor="#f5e8f8",color="#8c609e"]; items->af; group [label="section\nOBJECT"]; sec->group; gid [label="id / type / title\nLABEL",fillcolor="#f5e8f8",color="#8c609e"]; fields [label="fields\nARRAY",fillcolor="#fff1d5",color="#b88b3c"]; group->{gid fields}; val [label="tenor, rate, etc.\nFIELD",fillcolor="#f5e8f8",color="#8c609e"]; fields->val; cap [label="caption\nLABEL",fillcolor="#f5e8f8",color="#8c609e"]; act [label="actions\nVALUE",fillcolor="#f5e8f8",color="#8c609e"]; f->{cap act}; }