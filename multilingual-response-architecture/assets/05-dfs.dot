digraph G { graph [bgcolor="#ffffff", pad="0.35", nodesep="0.3", ranksep="0.48", fontname="DejaVu Sans", fontsize=18, fontcolor="#142b45", labelloc=t, splines=polyline]; node [shape=box, style="rounded,filled", fillcolor="#eaf1f8", color="#456a8e", fontname="DejaVu Sans", fontsize=12, fontcolor="#142b45", margin="0.18,0.12"]; edge [color="#6b8196", arrowsize=0.7, fontname="DejaVu Sans", fontsize=10, fontcolor="#42556a"]; rankdir=TB; label="DFS entry order and return-time materialization"; 
r [label="1  Root OBJECT",fillcolor="#d9eee5",color="#328262"]; h [label="2  Header OBJECT"]; t [label="3  Title LABEL",fillcolor="#f5e8f8",color="#8c609e"]; a [label="4  Amount OBJECT"]; i [label="5  Items ARRAY",fillcolor="#fff1d5",color="#b88b3c"]; f [label="6  Amount FIELD",fillcolor="#f5e8f8",color="#8c609e"]; r->h [label="enter"]; h->t [label="enter"]; r->a [label="next branch"]; a->i->f; t->h [style=dashed,color="#328262",label="return",constraint=false]; h->r [style=dashed,color="#328262",label="return",constraint=false]; f->i [style=dashed,color="#328262",constraint=false]; i->a [style=dashed,color="#328262",constraint=false]; a->r [style=dashed,color="#328262",constraint=false]; key [shape=note,label="Entry: 1, 2, 3, 4, 5, 6\nCompletion: 3, 2, 6, 5, 4, 1\nSolid = descent; dashed = return",fillcolor="#ffffff"]; {rank=same;r;key} }